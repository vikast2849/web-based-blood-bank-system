# =====================================================================
# Web-Based Blood Bank System - Environment Configuration Template
# Copy this file to .env and fill in your cloud database credentials.
# NOTE: Never commit your actual .env file or credentials to Git.
# =====================================================================

# Database Connection Settings (e.g. Aiven, Railway, AWS RDS, TiDB)
DB_HOST=your-mysql-hostname.example.com
DB_PORT=3306
DB_NAME=bloodbank
DB_USER=your_db_username
DB_PASS=your_db_password

# Application Settings
APP_ENV=production
